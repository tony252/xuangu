{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "xuangu-tony252",
  "account_id": "22dc4c763c65296231e471b46a70764e",
  "main": "./src/index.js",
  "compatibility_date": "2026-05-29",
  "workers_dev": false,
  "vars": {
    "CLOUDFLARE_SCHEDULER_ENABLED": "0"
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "ratelimits": [
    {
      "name": "LIVE_RATE_LIMITER",
      "namespace_id": "2026102201",
      "simple": {
        "limit": 90,
        "period": 60
      }
    }
  ],
  "routes": [
    {
      "pattern": "tony252.ccwu.cc/*",
      "zone_name": "tony252.ccwu.cc"
    }
  ]
}
